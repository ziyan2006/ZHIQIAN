[Unit]
Description=Raspberry Pi Smart Embedded Web Dashboard
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pi_web_server
ExecStart=/home/pi/pi_web_server/.venv/bin/python /home/pi/pi_web_server/app.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=WEB_HOST=::

[Install]
WantedBy=multi-user.target
